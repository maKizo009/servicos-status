{
  "version": 2,
  "outputDirectory": "src/public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/public/index.html"
    },
    {
      "source": "/admin",
      "destination": "/src/public/admin.html"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index"
    },
    {
      "source": "/llms-instructions.txt",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/src/public/$1"
    }
  ]
}