TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo entre ciclos de verificação (ms)
CHECK_INTERVAL_MS=60000

# Timeouts (ms)
CONNECTIVITY_TIMEOUT_MS=5000
BGP_TIMEOUT_MS=15000

# Porta do servidor HTTP
HTTP_PORT=3030

# Latency thresholds (ms)
LATENCY_OK_MS=500
LATENCY_WARN_MS=2000

# Packet loss thresholds (%)
LOSS_OK=0
LOSS_WARN=10

# =================== Utilidades ===================

# Município alvo para monitoramento de utilidades (COPEL, Sanepar, etc.)
# Deixe vazio para desabilitar essas verificações
MUNICIPIO=IPIRANGA

# COPEL - API ANEEL Informações
COPEL_API_URL=https://cdn.copel.com/aneel-informacoes/api/portal/mapa_poligonos_data
COPEL_TIMEOUT_MS=30000

# Sanepar - Views AJAX
SANEPAR_VIEWS_AJAX=https://www.sanepar.com.br/views/ajax
SANEPAR_PAGE_URL=https://www.sanepar.com.br/esta-sem-agua
SANEPAR_VIEW_NAME=notices_panel_supply_stop

# Intervalo entre relatórios unificados no Telegram (ms)
# 0 para desabilitar relatórios periódicos
UNIFIED_REPORT_INTERVAL_MS=3600000

# =================== IA & Clima (AI-First) ===================
# Chave de API da NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Modelo Meteorológico (Default: ecmwf_ifs04 - Modelo Europeu ECMWF "O Rei")
WEATHER_MODEL=ecmwf_ifs04

# Gemini API Key (opcional / fallback)
GEMINI_API_KEY=

# VLM principal via OpenCode Go (OpenAI-compatível) — minimax-m3: visão + custo
# baixo por token. Chave: https://opencode.ai/auth (pay-as-you-go ou $10/mês)
OPENCODE_API_KEY=
OPENCODE_VLM_MODEL=minimax-m3

# =================== Banco de Dados Turso (LibSQL / Cloud SQLite) ===================
# Placeholder — a URL REAL fica só no .env / secrets do Vercel (achado GLM 5.2:
# .env.example commitado não pode expor nome do banco/região).
TURSO_DATABASE_URL=libsql://your-database-name.your-org.turso.io
TURSO_AUTH_TOKEN=